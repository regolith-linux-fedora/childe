# Generated by porting/scripts/gen-fedora-packaging.py from childe/debian/. Do not edit by hand.
Name:           childe
Version:        0.1.5
Release:        1%{?dist}
Summary:        Utility to open next workspace
License:        GPL-3.0-or-later
URL:            https://github.com/regolith-linux/childe
Source0:        %{name}-%{version}.tar.gz

# Rust binaries carry no debug-friendly build-id split yet; keep debuginfo off for the POC
%global debug_package %{nil}
BuildRequires:  make
BuildRequires:  cargo
BuildRequires:  rust


%description
An wm utility intended to be called by keybinding
to open next available empty workspace.

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > childe.files

%files -f childe.files

